@using Excubo.Blazor.Canvas
@using Excubo.Blazor.Canvas.Contexts
@using System.Diagnostics
@using Newtonsoft.Json
@using TravellingSalesmanProblem.Algorithms
@using TravellingSalesmanProblem.Graph
@using WebApplication.Utils
@using WebApplication.Components
@using StardustDL.RazorComponents.Markdown
<header>
    <nav class="navbar">
        <div class="container-fluid">
            <h5>Interactive Visualization of Heuristics for the Traveling Salesman Problem</h5>
            <button class="btn btn-outline-primary btn-sm" type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#offcanvasWithBothOptions" aria-controls="offcanvasWithBothOptions">
                <i class="bi bi-question-lg"></i> Help
            </button>
        </div>
    </nav>
</header>
<div class="container-fluid">
    <div class="row gx-3">
        <div class="col-md-2">
            <div class="bg-custom-light custom-column-style">
                <!-- Algorithm Settings -->
                <div class="custom-input-group">
                    <h5 class="font-weight-bold">Algorithm Settings</h5>
                    <AlgorithmSettings @bind-AlgorithmEnum="@AppState.AlgorithmEnum"
                                       @bind-MultiStart="@AppState.MultiStart" />
                </div>
                <hr class="custom-hr" />
                <!-- Heuristic Settings -->
                <div class="custom-input-group">
                    <h5 class="font-weight-bold">Heuristic Settings</h5>
                    <form>
                        @if (AppState.AlgorithmEnum == AlgorithmEnum.NN && !AppState.MultiStart) {
                            <NearestNeighborSettings @bind-StartNode="@AppState.StartNode" />
                        }
                        @if (AppState.AlgorithmEnum == AlgorithmEnum.SA) {
                            <SimulatedAnnealingSettings @bind-AlphaSA="@AppState.AlphaSA"
                                                    @bind-PhaseLength="@AppState.PhaseLength"
                                                    @bind-MinTemp="@AppState.MinTemp"
                                                    @bind-StartTemp="@AppState.StartTemp"
                                                    @bind-NeighbourEnum="@AppState.NeighbourEnum"
                                                    @bind-CalculateTemperature="@AppState.CalculateTemperature" />
                        }
                        @if (AppState.AlgorithmEnum == AlgorithmEnum.HC) {
                            <HillClimbingSettings @bind-NeighbourEnum="@AppState.NeighbourEnum"
                                              @bind-DescentType="@AppState.DescentType" />
                        }
                        @if (AppState.AlgorithmEnum == AlgorithmEnum.AS) {
                            <AntSystemSettings @bind-Iterations="@AppState.Iterations"
                                           @bind-AlphaACS="@AppState.AlphaACS"
                                           @bind-AntCount="@AppState.AntCount" @bind-Beta="@AppState.Beta"
                                           @bind-BreakWhenPathsAreEqual="@AppState.BreakWhenPathsAreEqual"
                                           @bind-GlobalUpdatingRule="@AppState.GlobalUpdatingRule"
                                           @bind-SelectionRule="@AppState.SelectionRule" />
                        }
                        @if (AppState.AlgorithmEnum == AlgorithmEnum.Manual) {
                            <ManualMoveSettings Tour="@CurrentTour()" CanUndo="@(AppState.GraphHistory?.Count > 1)"
                                            OnApply="ApplyManualMove" OnUndo="UndoManualMove"
                                            OnReset="ResetManualMoves" />
                        }
                    </form>
                </div>
                <hr class="custom-hr" />
                <!-- Canvas Settings -->
                <div class="custom-input-group">
                    <h5 class="font-weigth-bold">Canvas Settings</h5>
                    <CanvasDisplaySettings @bind-Scale="@AppState.Scale"
                                           @bind-NodeRadius="@AppState.NodeRadius"
                                           @bind-ShowGrid="@AppState.ShowGrid"
                                           @bind-AnnotateEdges="@AppState.AnnotateEdges"
                                           @bind-ColorizeChanges="@AppState.ColorizeChanges"
                                           @bind-AnimationDelay="@AppState.AnimationDelay" />
                </div>
                <hr class="custom-hr" />
                <!-- Graph Settings -->
                <div class="custom-input-group">
                    <h5 class="font-weight-bold">Graph Settings</h5>
                    <div class="form-group">
                        <label for="selectGraphSource">Graph Source</label>
                        <select class="form-control" name="graphSource" id="selectGraphSource" @bind="AppState.GraphSource">
                            <option value="Text" @onselect="e => AppState.GraphSource = GraphSource.Text">Text</option>
                            <option value="File" @onselect="e => AppState.GraphSource = GraphSource.File">File</option>
                            <option value="Random" @onselect="e => AppState.GraphSource = GraphSource.Random">Random</option>
                        </select>
                    </div>
                    <div style="margin-top: 0.5rem;">
                        @if (AppState.GraphSource == GraphSource.Text) {
                            <div class="form-group">
                                <textarea class="form-control" @bind="AppState.DefaultGraph" style="height: 200px;"></textarea>
                                <small class="form-text text-muted">
                                    <code>n,index,x,y</code> per node. Simulated Annealing and Hill Climbing
                                    start from the order the nodes are listed in; add
                                    <code>t,index,index,&hellip;</code> to give an explicit starting tour.
                                </small>
                            </div>
                        } else if (AppState.GraphSource == GraphSource.Random) {
                            <RandomGraphSettings @bind-NodeCount="AppState.NodeCount"
                                             @bind-MaxX="AppState.MaxX"
                                             @bind-MaxY="AppState.MaxY" />
                        } else if (AppState.GraphSource == GraphSource.File) {
                            <FileInput @ref="@AppState.FileInput" />
                        }
                        <div class="d-grid gap-2 mx-auto" style="margin-top: 0.5rem;">
                            <button class="btn btn-primary" type="button" @onclick="e => InitiateGraph(AppState.GraphSource)">Execute Algorithm</button>
                            @if (AppState.Instance != null) {
                                <FileOutput @ref="@AppState.FileOutput" />
                            }
                        </div>
                    </div>
                </div>
                <!-- Error -->
                @if (!string.IsNullOrEmpty(AppState.Error)) {
                    <hr class="custom-hr" />
                    <div class="bg-danger custom-input-group" style="margin: 1rem;">
                        <h5 class="font-weight-bold">Error</h5>
                        <p>@AppState.Error</p>
                    </div>
                }
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-custom-light custom-column-style">
                <!-- State -->
                <div class="custom-input-group">
                    <h5 class="font-weight-bold">Visualization Control</h5>
                    @if (AppState.GraphHistory != null) {
                        <div class="input-group">
                            <div class="btn-toolbar">
                                <button type="button" disabled="@(AppState.GraphHistory.First == AppState.CurrentHistoryNode)"
                                    class="btn btn-primary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Jump First"
                                    @onclick="e => JumpFirst()">
                                    <i class="bi bi-chevron-double-left"></i>
                                </button>
                                <button type="button" disabled="@(AppState.GraphHistory.First == AppState.CurrentHistoryNode)"
                                    class="btn btn-primary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Reverse"
                                    @onclick="e => ReverseHistory()">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                @if (AppState.AutoAdvance) {
                                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top"
                                    title="Pause" @onclick="e => AppState.AutoAdvance = false">
                                        <i class="bi bi-pause"></i>
                                    </button>
                                } else {
                                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top"
                                    title="Play" @onclick="e => AppState.AutoAdvance = true">
                                        <i class="bi bi-play"></i>
                                    </button>
                                }
                                <button type="button" disabled="@(AppState.GraphHistory.Last == AppState.CurrentHistoryNode)"
                                    class="btn btn-primary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Advance"
                                    @onclick="e => AdvanceHistory()">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                <button type="button" disabled="@(AppState.GraphHistory.Last == AppState.CurrentHistoryNode)"
                                    class="btn btn-primary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="Jump Last"
                                    @onclick="e => JumpLast()">
                                    <i class="bi bi-chevron-double-right"></i>
                                </button>
                            </div>
                        </div>
                        <span>
                            Execution Time: @AppState.TimeSpan.Minutes m @AppState.TimeSpan.Seconds s
                            @AppState.TimeSpan.Milliseconds ms (@Math.Round((double)AppState.Stopwatch.ElapsedMilliseconds / 1000, 3) s)
                        </span>

                        <br />
                        @if (AppState.CurrentHistoryNode != null) {
                            @foreach (var kvp in AppState.CurrentHistoryNode.Value.Messages) {
                                <span><strong>@kvp.Key</strong>: @kvp.Value</span>

                                <br />
                            }
                        }
                    }
                </div>
                <hr class="custom-hr" />
                <!-- Graph View -->
                <div class="custom-input-group">
                    <h5 class="font-weight-bold">Graph View</h5>
                    @if (ShowsPreviousCanvas) {
                        <h6>@(AppState.AlgorithmEnum == AlgorithmEnum.Manual ? "Previous (Before the Move)" : "Previous (Iteration Start)")</h6>
                        <div class="row">
                            <Canvas @ref="@AppState.PreviousCanvas"
                                    width="@AppState.CanvasSettings.Width"
                                    height="@AppState.CanvasSettings.Height" />                            
                        </div>
                    }
                    <h6>@(AppState.AlgorithmEnum == AlgorithmEnum.Manual ? "Current (After the Move)" : "Current (Iteration End)")</h6>
                    <div class="row">
                        <Canvas @ref="@AppState.CurrentCanvas"
                                width="@AppState.CanvasSettings.Width"
                                height="@AppState.CanvasSettings.Height" />                    
                    </div>
                </div>
                <!-- Calculations -->
                @if (AppState.GraphHistory != null &&
                AppState.CurrentHistoryNode.Value != null &&
                AppState.CurrentHistoryNode.Value.Equations.Count != 0) {
                    <hr class="custom-hr" />
                    <div class="custom-input-group">
                        <h5 class="font-weight-bold">Calculations</h5>
                        @foreach (var kvp in AppState.CurrentHistoryNode.Value.Equations) {
                            <span>@kvp.Key</span>

                            <br />
                            <MarkdownRenderer Value="@kvp.Value.Latex" />
                            <MarkdownRenderer Value="@kvp.Value.Generate()" />
                            <MarkdownRenderer Value="@kvp.Value.Result" />
                        }
                    </div>
                }
            </div>
        </div>
        <div class="col-md-6">
            <div class="bg-custom-light custom-column-style">
                <!-- Charts -->
                @if (AppState.GraphHistory != null &&
                AppState.CurrentHistoryNode.Value.ChartInfo.Count >= 1) {
                    <div class="custom-input-group">
                        @if (AppState.AlgorithmEnum is AlgorithmEnum.SA) {
                            <div class="row">
                                <div class="col-md-6">
                                    <ChartJS @ref="@AppState.ChartJS[0]"
                                     Chart="@AppState.CurrentHistoryNode.Value.ChartInfo[0]"
                                     ChartID="sa_temperature">
                                    </ChartJS>
                                </div>
                                @if (AppState.CurrentHistoryNode.Value.ChartInfo.Count >= 2) {
                                    <div class="col-md-6">
                                        <ChartJS @ref="@AppState.ChartJS[1]"
                                     Chart="@AppState.CurrentHistoryNode.Value.ChartInfo[1]"
                                     ChartID="sa_distance">
                                        </ChartJS>
                                    </div>
                                }
                            </div>
                        }
                        @if (AppState.AlgorithmEnum is AlgorithmEnum.HC) {
                            <div class="col-md-12">
                                <ChartJS @ref="@AppState.ChartJS[0]"
                                 Chart="@AppState.CurrentHistoryNode.Value.ChartInfo[0]"
                                 ChartID="hc_distance">
                                </ChartJS>
                            </div>
                        }
                        @if (AppState.AlgorithmEnum is AlgorithmEnum.Manual) {
                            <div class="col-md-12">
                                <ChartJS @ref="@AppState.ChartJS[0]"
                                 Chart="@AppState.CurrentHistoryNode.Value.ChartInfo[0]"
                                 ChartID="manual_distance">
                                </ChartJS>
                            </div>
                        }
                    </div>
                    <hr class="custom-hr" />
                }
                <!-- Tables -->
                <div class="custom-input-group">
                    <TableGenerator @ref="@AppState.TableGenerator" MaxCols="12" MaxRows="12" />
                </div>
                @* Playing the search by hand means reading distances off the matrix, so it has to be
                   on screen next to the log of what has been played. *@
                @if (AppState.AlgorithmEnum == AlgorithmEnum.Manual && AppState.GraphHistory != null) {
                    <hr class="custom-hr" />
                    <div class="custom-input-group">
                        <TableGenerator @ref="@AppState.DistanceTable" Kind="TableKind.DistanceMatrix"
                                    MaxCols="12" MaxRows="12" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<Help />

@code {
    private AppState AppState = new();

    private FileInput subscribedFileInput;

    protected override Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender)
            _ = RunAnimationLoop();

        /* AppState.FileInput starts as a placeholder instance and is only replaced by the real
         * component once the File source is selected and @ref runs. Subscribing once on the first
         * render therefore attached the handler to an object that never raises the event, so
         * picking a file never refreshed the page. Re-subscribe whenever the instance changes. */
        if (!ReferenceEquals(subscribedFileInput, AppState.FileInput)) {
            if (subscribedFileInput != null)
                subscribedFileInput.LoadedFileChanged -= OnLoadedFileChanged;

            subscribedFileInput = AppState.FileInput;

            if (subscribedFileInput != null)
                subscribedFileInput.LoadedFileChanged += OnLoadedFileChanged;
        }

        /* The distance matrix only exists in the manual mode, so @ref assigns it during the render
         * that follows the run - after UpdateVisualsFromGraphState has already been past. Without
         * this it would stay empty until the next redraw. */
        if (ShowsDistanceTable && AppState.DistanceTable is { HasData: false } && AppState.CurrentHistoryNode != null) {
            AppState.DistanceTable.UpdateFromGraphState(
                AppState.CurrentHistoryNode, AppState.AlgorithmEnum, AppState.NeighbourEnum);
        }

        return base.OnAfterRenderAsync(firstRender);
    }

    private void OnLoadedFileChanged() => InvokeAsync(StateHasChanged);

    /* Ran on a raw Task.Run, so the redraw and StateHasChanged happened off the renderer's
     * dispatcher. It also woke every AnimationDelay milliseconds - one millisecond by default -
     * even while paused, burning a timer tick a thousand times a second for the life of the page. */
    private async Task RunAnimationLoop() {
        const int PausedPollDelay = 100;
        const int MinimumFrameDelay = 16;

        while (true) {
            if (!AppState.AutoAdvance) {
                await Task.Delay(PausedPollDelay);
                continue;
            }

            await Task.Delay(Math.Max(AppState.AnimationDelay, MinimumFrameDelay));

            if (AppState.AutoAdvance)
                await InvokeAsync(() => AdvanceHistory(true));
        }
    }

    public async Task InitiateGraph(GraphSource graphSource) {
        switch (graphSource) {
            case GraphSource.Text:
                try {
                    //if (!string.IsNullOrEmpty(AppState.DefaultGraph) && !string.IsNullOrWhiteSpace(AppState.DefaultGraph))
                    AppState.Instance = GraphProblem.FromText(AppState.DefaultGraph);
                } catch (FormatException e) {
                    /* The parser names what is wrong with the line or the tour; swallowing that and
                     * replacing it with "not a valid graph definition" hides the one thing the
                     * reader needs. */
                    AppState.Error = e.Message;
                    return;
                } catch (Exception) {
                    AppState.Error = "The specified text does not contain a valid graph definition.";
                    return;
                }
                break;
            case GraphSource.Random:
                AppState.Instance = GraphProblem.RandomGraphProblem(AppState.MaxX, AppState.MaxY, AppState.NodeCount);
                break;
            case GraphSource.File:
                try {
                    AppState.Instance = GraphProblem.FromText(AppState.FileInput.LoadedFile);
                } catch (FormatException e) {
                    AppState.Error = e.Message;
                    return;
                } catch (Exception) {
                    AppState.Error = "The specified file does not contain a valid graph definition.";
                    return;
                }
                break;
        }

        if (AppState.Instance.Nodes.Count == 0) {
            AppState.Error = "Could not load the specified graph.";
            return;
        }

        AppState.Error = null;
        AppState.CanvasSettings.MinPos = AppState.Instance.FindMin();
        AppState.CanvasSettings.MaxPos = AppState.Instance.FindMax();
        AppState.CanvasSettings.Scale = AppState.Scale;
        AppState.CanvasSettings.NodeRadius = AppState.NodeRadius;
        AppState.CanvasSettings.ShowGrid = AppState.ShowGrid;
        AppState.CanvasSettings.BackgroundColor = AppState.BackgroundColor;

        await UpdateEnumerator();
    }

    private async Task JumpFirst() {
        AppState.AutoAdvance = false;
        var canChange = await CanChangeHistory();
        if (!canChange)
            return;

        if (AppState.GraphHistory.First == null)
            return;

        AppState.CurrentHistoryNode = AppState.GraphHistory.First;
        await Redraw();
    }

    private async Task JumpLast() {
        AppState.AutoAdvance = false;
        var canChange = await CanChangeHistory();
        if (!canChange)
            return;

        if (AppState.GraphHistory.Last == null)
            return;

        AppState.CurrentHistoryNode = AppState.GraphHistory.Last;
        await Redraw();
    }

    private async Task AdvanceHistory(bool automatic = false) {
        if (!automatic)
            AppState.AutoAdvance = false;

        var canChange = await CanChangeHistory();
        if (!canChange)
            return;

        if (AppState.CurrentHistoryNode.Next == null)
            return;

        AppState.CurrentHistoryNode = AppState.CurrentHistoryNode.Next;
        await Redraw();
    }

    private async Task ReverseHistory() {
        AppState.AutoAdvance = false;
        var canChange = await CanChangeHistory();
        if (!canChange)
            return;

        if (AppState.CurrentHistoryNode.Previous == null)
            return;

        AppState.CurrentHistoryNode = AppState.CurrentHistoryNode.Previous;
        await Redraw();
    }

    private async Task<bool> CanChangeHistory() {
        if (AppState.GraphHistory == null)
            return false;
        if (AppState.CurrentHistoryNode == null) {
            AppState.CurrentHistoryNode = AppState.GraphHistory.First;
            await Redraw();
            return false;
        }

        return true;
    }

    private async Task Redraw() {
        AppState.CanvasSettings.Annotate = AppState.AnnotateEdges;
        AppState.CanvasSettings.Colorize = AppState.ColorizeChanges;

        await FillCanvases();
        await UpdateVisualsFromGraphState();
        StateHasChanged();
    }

    private async Task FillCanvases() {
        if (ShowsPreviousCanvas) {
            /* Stepping back to the first state left the "Previous" canvas showing whatever frame
             * was drawn last, because it was only ever painted when a previous state existed. */
            if (AppState.CurrentHistoryNode.Previous != null)
                await FillCanvas(AppState.PreviousCanvas, AppState.CurrentHistoryNode.Previous.Value);
            else
                await ResetCanvasOf(AppState.PreviousCanvas);
        }

        await FillCanvas(AppState.CurrentCanvas, AppState.CurrentHistoryNode.Value);
    }

    /* Clear, grid, edges and nodes all go into one Batch2D, which flushes as a single JS interop
     * call. Previously each of them issued its own round trip per primitive - a 30 node instance
     * with the grid on was several thousand calls per canvas, twice per animation frame. */
    private async Task FillCanvas(Canvas canvas, GraphState state) {
        if (canvas == null)
            return;

        var settings = AppState.CanvasSettings;
        await using var context = await canvas.GetContext2DAsync();

        /* Text metrics need a value back from the browser, so they cannot be taken inside a
         * batch; they are measured up front and only when annotations are actually drawn. */
        var annotations = await MeasureAnnotations(context, state);

        await using (var batch = context.CreateBatch()) {
            await ResetCanvas(batch, settings);
            await CanvasRenderer.DrawEdges(batch, state, AppState.CurrentHistoryNode, settings, annotations);
            await CanvasRenderer.DrawNodes(batch, state, AppState.CurrentHistoryNode, settings);
        }
    }

    private async Task<List<TextMetric>> MeasureAnnotations(Context2D context, GraphState state) {
        /* Ant runs put a pheromone level on every edge of the complete graph; annotating all of
         * them is unreadable, which is why this is suppressed. The renderer used to do it by
         * assigning to the shared CanvasSettings mid-draw. */
        if (!AppState.CanvasSettings.Annotate || state.PathEdges.Any(e => e.Pheromone != 0))
            return null;

        var annotations = CanvasRenderer.BuildAnnotations(state);
        var measured = new Dictionary<string, (double Width, double Height)>();

        foreach (var annotation in annotations) {
            if (!measured.TryGetValue(annotation.Text, out var size)) {
                var metrics = await context.MeasureTextAsync(annotation.Text);
                size = (metrics.Width, metrics.FontBoundingBoxAscent + metrics.FontBoundingBoxDescent);
                measured[annotation.Text] = size;
            }

            annotation.Width = size.Width;
            annotation.Height = size.Height;
        }

        return annotations;
    }

    private async Task ResetCanvases() {
        /* The "Previous" canvas is only in the markup for SA and HC. After switching away from
         * them AppState.PreviousCanvas still holds the removed component, and asking it for a
         * context throws because its element is no longer in the document - so the algorithm has
         * to be checked as well as the reference. */
        if (ShowsPreviousCanvas)
            await ResetCanvasOf(AppState.PreviousCanvas);

        await ResetCanvasOf(AppState.CurrentCanvas);
    }

    private async Task ResetCanvasOf(Canvas canvas) {
        if (canvas == null)
            return;

        await using var context = await canvas.GetContext2DAsync();
        await using var batch = context.CreateBatch();
        await ResetCanvas(batch, AppState.CanvasSettings);
    }

    private async Task ResetCanvas(IContext2DWithoutGetters context, CanvasSettings settings) {
        /* The cleared and repainted rectangle started at the graph's minimum coordinate rather
         * than at the canvas origin, so with a graph whose smallest coordinate was not zero a
         * strip along the top and left kept the previous frame's pixels. */
        await context.ClearRectAsync(0, 0, settings.Width, settings.Height);
        await context.FillStyleAsync(settings.BackgroundColor);
        await context.FillRectAsync(0, 0, settings.Width, settings.Height);

        if (settings.ShowGrid)
            await CanvasRenderer.DrawGrid(context, settings);
    }

    /* The "Previous" canvas shows the state a step is taken from. Simulated Annealing and Hill
     * Climbing use it for the iteration boundary, the manual mode for the tour before and after
     * the move that was just applied - which is the whole point of playing one by hand. */
    /* Only the manual mode has a second table, and AppState.DistanceTable keeps whatever @ref last
     * put there - so after switching away it still points at a component that is no longer in the
     * document. Same trap as the charts: the reference has to be checked together with the mode. */
    private bool ShowsDistanceTable => AppState.AlgorithmEnum == AlgorithmEnum.Manual;

    private bool ShowsPreviousCanvas =>
        AppState.AlgorithmEnum is AlgorithmEnum.SA or AlgorithmEnum.HC or AlgorithmEnum.Manual;

    /* The tour the move panel builds on: the one currently displayed, so that stepping back and
     * applying something else works on what is on screen rather than on the last state. */
    private GraphProblem CurrentTour() =>
        AppState.CurrentHistoryNode == null ? null : ManualSearch.TourOf(AppState.CurrentHistoryNode.Value);

    private async Task ApplyManualMove(ITourMove move) {
        if (AppState.GraphHistory == null || AppState.CurrentHistoryNode == null || move == null)
            return;

        AppState.AutoAdvance = false;
        AppState.CurrentHistoryNode =
            AppState.ManualSearch.Apply(AppState.GraphHistory, AppState.CurrentHistoryNode, move);

        await Redraw();
    }

    private async Task UndoManualMove() {
        if (AppState.GraphHistory == null)
            return;

        AppState.AutoAdvance = false;
        AppState.CurrentHistoryNode = ManualSearch.Undo(AppState.GraphHistory);
        await Redraw();
    }

    private async Task ResetManualMoves() {
        if (AppState.GraphHistory == null)
            return;

        AppState.AutoAdvance = false;
        AppState.CurrentHistoryNode = ManualSearch.Reset(AppState.GraphHistory);
        await Redraw();
    }

    private async Task UpdateEnumerator() {
        AppState.Instance.Reset();
        AppState.TableGenerator.Reset();
        if (ShowsDistanceTable)
            AppState.DistanceTable?.Reset();
        await ResetCanvases();

        AppState.Stopwatch.Restart();

        switch (AppState.AlgorithmEnum) {
            case AlgorithmEnum.NN:
                AppState.NearestNeighbor.Start = AppState.Instance.Nodes[AppState.StartNode];
                AppState.GraphHistory = AppState.MultiStart ?
                    AppState.NearestNeighbor.MultiStart(AppState.Instance) :
                    AppState.NearestNeighbor.FindPath(AppState.Instance);
                break;
            case AlgorithmEnum.SA:
                AppState.SimulatedAnnealing.Alpha = AppState.AlphaSA;
                AppState.SimulatedAnnealing.PhaseLength = AppState.PhaseLength;
                AppState.SimulatedAnnealing.StartTemp = AppState.StartTemp;
                AppState.SimulatedAnnealing.MinTemp = AppState.MinTemp;
                AppState.SimulatedAnnealing.NeighbourEnum = AppState.NeighbourEnum;
                AppState.SimulatedAnnealing.CalculateTemperature = AppState.CalculateTemperature;
                AppState.GraphHistory = AppState.SimulatedAnnealing.FindPath(AppState.Instance);
                break;
            case AlgorithmEnum.AS:
                AppState.AntSystem.Iterations = AppState.Iterations;
                AppState.AntSystem.AntCount = AppState.AntCount;
                AppState.AntSystem.Alpha = AppState.AlphaACS;
                AppState.AntSystem.Beta = AppState.Beta;
                AppState.AntSystem.BreakWhenPathsAreEqual = AppState.BreakWhenPathsAreEqual;
                AppState.AntSystem.GlobalUpdatingRule = AppState.GlobalUpdatingRule;
                AppState.AntSystem.SelectionRule = AppState.SelectionRule;
                AppState.GraphHistory = AppState.AntSystem.FindPath(AppState.Instance);
                break;
            case AlgorithmEnum.HC:
                AppState.HillClimbing.NeighbourEnum = AppState.NeighbourEnum;
                AppState.HillClimbing.DescentType = AppState.DescentType;
                AppState.GraphHistory = AppState.MultiStart ?
                    AppState.HillClimbing.MultiStart(AppState.Instance) :
                    AppState.HillClimbing.FindPath(AppState.Instance);
                break;
            case AlgorithmEnum.Manual:
                /* Nothing is searched here. The history starts with the given tour and grows one
                 * entry per move the user applies. */
                AppState.GraphHistory = AppState.ManualSearch.FindPath(AppState.Instance);
                break;
        }

        AppState.FileOutput.LoadedFile = GraphProblem.SerializeGraph(AppState.Instance);
        AppState.Stopwatch.Stop();
        AppState.TimeSpan = AppState.Stopwatch.Elapsed;

        AppState.CurrentHistoryNode = AppState.GraphHistory.First;
        await Redraw();
    }

    private async Task UpdateVisualsFromGraphState() {
        AppState.TableGenerator.UpdateFromGraphState(AppState.CurrentHistoryNode, AppState.AlgorithmEnum, AppState.NeighbourEnum);
        if (ShowsDistanceTable) {
            AppState.DistanceTable?.UpdateFromGraphState(
                AppState.CurrentHistoryNode, AppState.AlgorithmEnum, AppState.NeighbourEnum);
        }

        /* AppState.ChartJS keeps whatever @ref last put there, so after a run that rendered charts
         * the entries survive a switch to an algorithm that renders none - and updating one of
         * those calls into a canvas that is no longer in the document. Only the charts the current
         * markup actually shows are refreshed, which mirrors the @if blocks above. */
        for (int i = 0; i < ChartCount(); i++) {
            var chart = AppState.ChartJS[i];
            if (chart != null)
                await chart.UpdateFromGraphState();
        }
    }

    private int ChartCount() {
        var available = AppState.CurrentHistoryNode?.Value.ChartInfo?.Count ?? 0;

        return AppState.AlgorithmEnum switch {
            AlgorithmEnum.SA => Math.Min(2, available),
            AlgorithmEnum.HC or AlgorithmEnum.Manual => Math.Min(1, available),
            _ => 0
        };
    }
}