@using System.Diagnostics
@using Newtonsoft.Json
@using TravellingSalesmanProblem.Algorithms
@using TravellingSalesmanProblem.Graph
@using WebApplication.Utils
@using WebApplication.Components
@using WebApplication.Components.Layout
@using StardustDL.RazorComponents.Markdown
@inject IJSRuntime JS
<header class="app-header">
    <h5>Interactive Visualization of Heuristics for the Traveling Salesman Problem</h5>
    <div class="app-header-actions">
        @* Text size for the whole app, the graph's node numbers included - which is also what sizes
           the nodes, so there is no separate node size to set. *@
        <div class="segmented text-size-switch" role="group" aria-label="Text size">
            @foreach (var (size, label) in TextSizes) {
                <button type="button" class="btn btn-sm btn-toggle text-size-@size" aria-pressed="@(textSize == size ? "true" : "false")"
                        title="@label text" aria-label="@label text" @onclick="() => SetTextSize(size)">A</button>
            }
        </div>
        <button class="btn btn-outline-primary btn-sm" type="button" @onclick="ToggleTheme"
                title="@(theme == "light" ? "Switch to the dark theme" : "Switch to the light theme")">
            <Icon Name="@(theme == "light" ? "moon" : "sun")" />
        </button>
        <button class="btn btn-outline-primary btn-sm" type="button" @onclick="() => helpPanel.Show()">
            <Icon Name="circle-help" /> Help
        </button>
    </div>
</header>
<div class="workspace">
    <!-- Settings: the instance first (what is solved), then the algorithm (how). How it is drawn
         lives in the view bar under the canvases. -->
    <aside class="sidebar">
        <SidebarSection Title="Instance">
            <div class="form-group">
                <label for="selectGraphSource">Source</label>
                <select class="form-control" name="graphSource" id="selectGraphSource" @bind="AppState.GraphSource">
                    <option value="Text" @onselect="e => AppState.GraphSource = GraphSource.Text">Text</option>
                    <option value="File" @onselect="e => AppState.GraphSource = GraphSource.File">File</option>
                    <option value="Random" @onselect="e => AppState.GraphSource = GraphSource.Random">Random</option>
                </select>
            </div>
            <div class="sidebar-subsection">
                @if (AppState.GraphSource == GraphSource.Text) {
                    <div class="form-group">
                        <textarea class="form-control graph-text" @bind="AppState.DefaultGraph" aria-label="Graph definition"></textarea>
                        <small class="form-text text-muted">
                            <code>n,index,x,y</code> per node. Simulated Annealing and Hill Climbing
                            start from the order the nodes are listed in; add
                            <code>t,index,index,&hellip;</code> to give an explicit starting tour.
                        </small>
                    </div>
                } else if (AppState.GraphSource == GraphSource.Random) {
                    <RandomGraphSettings @bind-NodeCount="AppState.NodeCount"
                                         @bind-MaxX="AppState.MaxX"
                                         @bind-MaxY="AppState.MaxY" />
                } else if (AppState.GraphSource == GraphSource.File) {
                    <FileInput @ref="@AppState.FileInput" />
                }
            </div>
            @* The download is the graph this section produced - most useful for keeping a random
               instance - so it sits with the graph's settings, not with the run's actions. *@
            @if (AppState.Instance != null) {
                <div class="sidebar-actions">
                    <FileOutput Content="@AppState.SourceText" />
                </div>
            }
        </SidebarSection>

        <SidebarSection Title="Algorithm">
            <AlgorithmSettings @bind-AlgorithmEnum="@AppState.AlgorithmEnum"
                               @bind-MultiStart="@AppState.MultiStart" />
            <div class="sidebar-subsection">
                @if (AppState.AlgorithmEnum == AlgorithmEnum.NN && !AppState.MultiStart) {
                    <NearestNeighborSettings @bind-StartNode="@AppState.StartNode" />
                }
                @if (AppState.AlgorithmEnum == AlgorithmEnum.SA) {
                    <SimulatedAnnealingSettings @bind-AlphaSA="@AppState.AlphaSA"
                                                @bind-PhaseLength="@AppState.PhaseLength"
                                                @bind-MinTemp="@AppState.MinTemp"
                                                @bind-StartTemp="@AppState.StartTemp"
                                                @bind-NeighbourEnum="@AppState.NeighbourEnum"
                                                @bind-CalculateTemperature="@AppState.CalculateTemperature" />
                }
                @if (AppState.AlgorithmEnum == AlgorithmEnum.HC) {
                    <HillClimbingSettings @bind-NeighbourEnum="@AppState.NeighbourEnum"
                                          @bind-DescentType="@AppState.DescentType" />
                }
                @if (AppState.AlgorithmEnum == AlgorithmEnum.AS) {
                    <AntSystemSettings @bind-Iterations="@AppState.Iterations"
                                       @bind-AlphaACS="@AppState.AlphaACS"
                                       @bind-AntCount="@AppState.AntCount" @bind-Beta="@AppState.Beta"
                                       @bind-BreakWhenPathsAreEqual="@AppState.BreakWhenPathsAreEqual"
                                       @bind-GlobalUpdatingRule="@AppState.GlobalUpdatingRule"
                                       @bind-SelectionRule="@AppState.SelectionRule" />
                }
                @if (AppState.AlgorithmEnum == AlgorithmEnum.Manual) {
                    <ManualMoveSettings Tour="@CurrentTour()" CanUndo="@CanUndoManualMove"
                                        OnApply="ApplyManualMove" OnUndo="UndoManualMove"
                                        OnReset="ResetManualMoves" />
                }
            </div>
        </SidebarSection>
    </aside>

    <main class="stage">
        <!-- Toolbar: the main controls - running the algorithm and moving through its states -->
        <div class="stage-toolbar">
            <div class="stage-toolbar-row">
                <div class="toolbar-group" role="group" aria-label="Run">
                    <button class="btn btn-primary btn-sm" type="button" id="executeAlgorithm"
                            title="Run the heuristic on the graph" @onclick="e => InitiateGraph(AppState.GraphSource)">
                        Execute Algorithm
                    </button>
                </div>
            @if (AppState.GraphHistory != null) {
                <div class="btn-toolbar" role="group" aria-label="Playback">
                    <button type="button" disabled="@(AppState.GraphHistory.First == AppState.CurrentHistoryNode)"
                            class="btn btn-outline-secondary btn-sm" title="Jump First"
                            @onclick="e => JumpFirst()">
                        <Icon Name="chevrons-left" />
                    </button>
                    <button type="button" disabled="@(AppState.GraphHistory.First == AppState.CurrentHistoryNode)"
                            class="btn btn-outline-secondary btn-sm" title="Reverse"
                            @onclick="e => ReverseHistory()">
                        <Icon Name="chevron-left" />
                    </button>
                    @if (AppState.AutoAdvance) {
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                title="Pause" @onclick="e => AppState.AutoAdvance = false">
                            <Icon Name="pause" />
                        </button>
                    } else {
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                title="Play" @onclick="e => AppState.AutoAdvance = true">
                            <Icon Name="play" />
                        </button>
                    }
                    <button type="button" disabled="@(AppState.GraphHistory.Last == AppState.CurrentHistoryNode)"
                            class="btn btn-outline-secondary btn-sm" title="Advance"
                            @onclick="e => AdvanceHistory()">
                        <Icon Name="chevron-right" />
                    </button>
                    <button type="button" disabled="@(AppState.GraphHistory.Last == AppState.CurrentHistoryNode)"
                            class="btn btn-outline-secondary btn-sm" title="Jump Last"
                            @onclick="e => JumpLast()">
                        <Icon Name="chevrons-right" />
                    </button>
                </div>
                <span class="stage-toolbar-time" title="How long the heuristic took to compute the whole run">
                    Execution Time: @FormatDuration(AppState.TimeSpan)
                </span>
            } else {
                <span class="text-muted">Execute an algorithm to step through its states.</span>
            }
            </div>
            @if (!string.IsNullOrEmpty(AppState.Error)) {
                <div class="notice-error" role="alert">
                    <strong>Error</strong>: @AppState.Error
                </div>
            }
            @if (AppState.GraphHistory != null && AppState.CurrentHistoryNode != null) {
                <div class="stage-toolbar-state">
                    @foreach (var kvp in AppState.CurrentHistoryNode.Value.Messages) {
                        <span><strong>@kvp.Key</strong>: @kvp.Value</span>
                    }
                </div>
            }
        </div>

        <!-- Canvases: the state a step starts from and the state it ends on, side by side -->
        <div class="stage-canvases @(ShowsPreviousCanvas ? "pair" : null)">
            @if (ShowsPreviousCanvas) {
                <figure class="canvas-frame">
                    <figcaption>@PreviousCaption</figcaption>
                    <canvas id="@PreviousCanvasId"
                            width="@AppState.CanvasSettings.BufferWidth"
                            height="@AppState.CanvasSettings.BufferHeight"
                            style="@AppState.CanvasSettings.CssSize"
                            hidden="@(AppState.Instance == null)"></canvas>
                </figure>
            }
            @* The frame around the current canvas is the one measured for the fit (canvas.js): it
               is in the markup in every mode, and it has the same width as the previous one. *@
            <figure class="canvas-frame" @ref="currentFrame">
                <figcaption>@CurrentCaption</figcaption>
                <canvas id="@CurrentCanvasId"
                        width="@AppState.CanvasSettings.BufferWidth"
                        height="@AppState.CanvasSettings.BufferHeight"
                        style="@AppState.CanvasSettings.CssSize"
                        hidden="@(AppState.Instance == null)"></canvas>
                @if (AppState.Instance == null) {
                    <p class="canvas-empty text-muted">The graph is drawn here once an algorithm has been executed.</p>
                }
            </figure>
        </div>

        <!-- View: how the run is drawn and played back, next to the canvases it changes. These used to
             share the top bar with Run and playback, which crowded the main controls and wrapped. -->
        <div class="view-bar" role="group" aria-label="View options">
            <CanvasDisplaySettings @bind-ShowGrid="@AppState.ShowGrid" @bind-ShowGrid:after="ApplyView"
                                   @bind-AnnotateEdges="@AppState.AnnotateEdges" @bind-AnnotateEdges:after="ApplyView"
                                   @bind-ColorizeChanges="@AppState.ColorizeChanges" @bind-ColorizeChanges:after="ApplyView" />
            <div class="toolbar-field" role="group" aria-labelledby="speedLabel">
                <span id="speedLabel">Speed</span>
                <div class="segmented" id="playbackSpeed">
                    @foreach (var (delay, label) in PlaybackSpeeds) {
                        <button type="button" class="btn btn-sm btn-toggle" aria-pressed="@(AppState.AnimationDelay == delay ? "true" : "false")"
                                title="@($"{label}: one state every {FormatDuration(TimeSpan.FromMilliseconds(delay))} while playing")"
                                @onclick="() => AppState.AnimationDelay = delay">@label</button>
                    }
                </div>
            </div>
        </div>

        <!-- Views: tables, charts and calculations for the state shown above -->
        <DockTabs>
            <DockTab Title="History" Order="0">
                <TableGenerator @ref="@AppState.TableGenerator" MaxCols="12" MaxRows="12" />
            </DockTab>
            @* Playing the search by hand means reading distances off the matrix, so it has to be
               one click away from the log of what has been played. *@
            @if (AppState.AlgorithmEnum == AlgorithmEnum.Manual && AppState.GraphHistory != null) {
                <DockTab Title="Distance Matrix" Order="1">
                    <TableGenerator @ref="@AppState.DistanceTable" Kind="TableKind.DistanceMatrix"
                                    MaxCols="12" MaxRows="12" />
                </DockTab>
            }
            @if (AppState.GraphHistory != null &&
                 AppState.CurrentHistoryNode.Value.ChartInfo.Count >= 1) {
                <DockTab Title="Charts" Order="2">
                    @if (AppState.AlgorithmEnum is AlgorithmEnum.SA) {
                        <div class="chart-grid">
                            <div>
                                <ChartJS @ref="@AppState.ChartJS[0]"
                                         Chart="@AppState.CurrentHistoryNode.Value.ChartInfo[0]"
                                         Cursor="@AppState.CurrentHistoryNode.Value.ChartCursor"
                                         ChartID="sa_temperature">
                                </ChartJS>
                            </div>
                            @if (AppState.CurrentHistoryNode.Value.ChartInfo.Count >= 2) {
                                <div>
                                    <ChartJS @ref="@AppState.ChartJS[1]"
                                             Chart="@AppState.CurrentHistoryNode.Value.ChartInfo[1]"
                                             Cursor="@AppState.CurrentHistoryNode.Value.ChartCursor"
                                             ChartID="sa_distance">
                                    </ChartJS>
                                </div>
                            }
                        </div>
                    }
                    @if (AppState.AlgorithmEnum is AlgorithmEnum.HC) {
                        <ChartJS @ref="@AppState.ChartJS[0]"
                                 Chart="@AppState.CurrentHistoryNode.Value.ChartInfo[0]"
                                 ChartID="hc_distance">
                        </ChartJS>
                    }
                    @if (AppState.AlgorithmEnum is AlgorithmEnum.Manual) {
                        <ChartJS @ref="@AppState.ChartJS[0]"
                                 Chart="@AppState.CurrentHistoryNode.Value.ChartInfo[0]"
                                 ChartID="manual_distance">
                        </ChartJS>
                    }
                </DockTab>
            }
            @if (AppState.GraphHistory != null &&
                 AppState.CurrentHistoryNode?.Value?.Derivations is { Count: > 0 } derivations) {
                <DockTab Title="Calculations" Order="3">
                    <div class="drv-list">
                        @foreach (var derivation in derivations) {
                            <DerivationCard Derivation="@derivation" />
                        }
                    </div>
                </DockTab>
            }
        </DockTabs>
    </main>
</div>
<Help @ref="helpPanel" />

@code {
    private AppState AppState = new();

    private FileInput subscribedFileInput;

    private Help helpPanel;

    /* "light" or "dark", as theme.js reports it; index.html has already applied it to the page. */
    private string theme;

    /* "small", "medium" or "large": data-text-size on <html>, set by index.html before the CSS. */
    private string textSize = "medium";
    private static readonly (string Size, string Label)[] TextSizes = {
        ("small", "Small"), ("medium", "Medium"), ("large", "Large")
    };

    /* Playback steps one state per delay. A free millisecond field made the default (1 ms) play a
     * run faster than it can be followed; these are the speeds worth choosing between. The fastest
     * is one state per frame. */
    private static readonly (int Delay, string Label)[] PlaybackSpeeds = {
        (1000, "Slow"), (400, "Normal"), (150, "Fast"), (16, "Fastest")
    };

    /* One unit, the one that reads best: "425 ms", "3.27 s", "2 min 05 s". */
    private static string FormatDuration(TimeSpan t) =>
        t.TotalSeconds < 1 ? $"{t.TotalMilliseconds:0} ms"
        : t.TotalMinutes < 1 ? $"{t.TotalSeconds:0.00} s"
        : $"{(int)t.TotalMinutes} min {t.Seconds:00} s";

    /* The box the canvases are fitted to, as canvas.js last reported it, and whether the last fit
     * resized them. A resized canvas is cleared by the browser, and the new size only reaches the
     * element in the render after the fit, so the redraw waits for OnAfterRenderAsync. */
    private ElementReference currentFrame;
    private DotNetObjectReference<GraphView> pageReference;
    private (double Width, double ViewportHeight, double PixelRatio) canvasBox = (360, 900, 1);
    private bool canvasResized;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            _ = RunAnimationLoop();

            theme = await JS.InvokeAsync<string>("tspTheme.get");
            textSize = await JS.InvokeAsync<string>("tspTheme.getTextSize");
            AppState.CanvasSettings.Theme = await JS.InvokeAsync<CanvasTheme>("tspTheme.canvasColors");

            pageReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("tspCanvas.observe", currentFrame, pageReference);
            StateHasChanged();
        }

        if (canvasResized) {
            canvasResized = false;

            if (AppState.GraphHistory != null && AppState.CurrentHistoryNode != null)
                await FillCanvases();
        }

        /* AppState.FileInput starts as a placeholder instance and is only replaced by the real
         * component once the File source is selected and @ref runs. Subscribing once on the first
         * render therefore attached the handler to an object that never raises the event, so
         * picking a file never refreshed the page. Re-subscribe whenever the instance changes. */
        if (!ReferenceEquals(subscribedFileInput, AppState.FileInput)) {
            if (subscribedFileInput != null)
                subscribedFileInput.LoadedFileChanged -= OnLoadedFileChanged;

            subscribedFileInput = AppState.FileInput;

            if (subscribedFileInput != null)
                subscribedFileInput.LoadedFileChanged += OnLoadedFileChanged;
        }

        /* The distance matrix only exists in the manual mode, so @ref assigns it during the render
         * that follows the run - after UpdateVisualsFromGraphState has already been past. Without
         * this it would stay empty until the next redraw. */
        if (ShowsDistanceTable && AppState.DistanceTable is { HasData: false } && AppState.CurrentHistoryNode != null) {
            AppState.DistanceTable.UpdateFromGraphState(
                AppState.CurrentHistoryNode, AppState.AlgorithmEnum, AppState.NeighbourEnum);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    /* The view options in the toolbar apply to what is on the canvas now. ShowGrid and the node size
     * used to be copied over only when a graph was executed, so toggling them did nothing until
     * the next run. */
    private void SyncView() {
        var settings = AppState.CanvasSettings;
        settings.ShowGrid = AppState.ShowGrid;
        settings.Annotate = AppState.AnnotateEdges;
        settings.Colorize = AppState.ColorizeChanges;
    }

    private async Task ApplyView() {
        SyncView();

        if (AppState.GraphHistory != null && AppState.CurrentHistoryNode != null)
            await Redraw();
    }

    [JSInvokable]
    public void OnCanvasBox(double width, double viewportHeight, double pixelRatio) {
        canvasBox = (width, viewportHeight, pixelRatio);

        if (AppState.Instance != null && FitCanvases())
            StateHasChanged();
    }

    /* The height limit keeps a tall graph, or a single canvas in a wide column, from pushing the
     * toolbar and the views off the screen. */
    private bool FitCanvases() {
        var maxHeight = Math.Max(240, canvasBox.ViewportHeight * 0.65);
        var resized = AppState.CanvasSettings.Fit(canvasBox.Width, maxHeight, canvasBox.PixelRatio);
        canvasResized |= resized;
        return resized;
    }

    /* The page restyles itself through CSS; the canvas does not, so it is redrawn in the colours
     * the new theme's tokens resolve to. The charts are re-coloured by their own interop. */
    private async Task ToggleTheme() {
        theme = await JS.InvokeAsync<string>("tspTheme.set", theme == "light" ? "dark" : "light");
        AppState.CanvasSettings.Theme = await JS.InvokeAsync<CanvasTheme>("tspTheme.canvasColors");

        if (AppState.GraphHistory != null && AppState.CurrentHistoryNode != null)
            await Redraw();
    }

    /* The node numbers are drawn at the page's label size (--canvas-label-size), and the nodes are
     * sized around their numbers, so the canvas is redrawn with the new size. */
    private async Task SetTextSize(string size) {
        textSize = await JS.InvokeAsync<string>("tspTheme.setTextSize", size);
        AppState.CanvasSettings.Theme = await JS.InvokeAsync<CanvasTheme>("tspTheme.canvasColors");

        if (AppState.GraphHistory != null && AppState.CurrentHistoryNode != null)
            await Redraw();
    }

    private void OnLoadedFileChanged() => InvokeAsync(StateHasChanged);

    /* Ran on a raw Task.Run, so the redraw and StateHasChanged happened off the renderer's
     * dispatcher. It also woke every AnimationDelay milliseconds - one millisecond by default -
     * even while paused, burning a timer tick a thousand times a second for the life of the page. */
    private async Task RunAnimationLoop() {
        const int PausedPollDelay = 100;
        const int MinimumFrameDelay = 16;

        while (true) {
            if (!AppState.AutoAdvance) {
                await Task.Delay(PausedPollDelay);
                continue;
            }

            await Task.Delay(Math.Max(AppState.AnimationDelay, MinimumFrameDelay));

            if (AppState.AutoAdvance)
                await InvokeAsync(() => AdvanceHistory(true));
        }
    }

    public async Task InitiateGraph(GraphSource graphSource) {
        switch (graphSource) {
            case GraphSource.Text:
                try {
                    //if (!string.IsNullOrEmpty(AppState.DefaultGraph) && !string.IsNullOrWhiteSpace(AppState.DefaultGraph))
                    AppState.Instance = GraphProblem.FromText(AppState.DefaultGraph);
                } catch (FormatException e) {
                    /* The parser names what is wrong with the line or the tour; swallowing that and
                     * replacing it with "not a valid graph definition" hides the one thing the
                     * reader needs. */
                    AppState.Error = e.Message;
                    return;
                } catch (Exception) {
                    AppState.Error = "The specified text does not contain a valid graph definition.";
                    return;
                }
                break;
            case GraphSource.Random:
                AppState.Instance = GraphProblem.RandomGraphProblem(AppState.MaxX, AppState.MaxY, AppState.NodeCount);
                break;
            case GraphSource.File:
                try {
                    AppState.Instance = GraphProblem.FromText(AppState.FileInput.LoadedFile);
                } catch (FormatException e) {
                    AppState.Error = e.Message;
                    return;
                } catch (Exception) {
                    AppState.Error = "The specified file does not contain a valid graph definition.";
                    return;
                }
                break;
        }

        /* A one node graph crashed Nearest Neighbor and Ant System (there is no edge to take), and
         * with two there is no tour to improve. */
        if (AppState.Instance.Nodes.Count < 3) {
            AppState.Error = AppState.Instance.Nodes.Count == 0
                ? "The graph has no nodes. Add lines like n,1,4,2."
                : $"A tour needs at least 3 nodes; this graph has {AppState.Instance.Nodes.Count}.";
            return;
        }

        AppState.Error = null;
        AppState.CanvasSettings.MinPos = AppState.Instance.FindMin();
        AppState.CanvasSettings.MaxPos = AppState.Instance.FindMax();
        AppState.CanvasSettings.SetNodes(AppState.Instance.Nodes.Select(n => n.Position).ToList());
        FitCanvases();
        SyncView();

        await UpdateEnumerator();
    }

    private async Task JumpFirst() {
        AppState.AutoAdvance = false;
        var canChange = await CanChangeHistory();
        if (!canChange)
            return;

        if (AppState.GraphHistory.First == null)
            return;

        AppState.CurrentHistoryNode = AppState.GraphHistory.First;
        await Redraw();
    }

    private async Task JumpLast() {
        AppState.AutoAdvance = false;
        var canChange = await CanChangeHistory();
        if (!canChange)
            return;

        if (AppState.GraphHistory.Last == null)
            return;

        AppState.CurrentHistoryNode = AppState.GraphHistory.Last;
        await Redraw();
    }

    private async Task AdvanceHistory(bool automatic = false) {
        if (!automatic)
            AppState.AutoAdvance = false;

        var canChange = await CanChangeHistory();
        if (!canChange)
            return;

        /* At the last state playback stops. It used to keep ticking with Pause still showing,
         * and the next run then started playing by itself. */
        if (AppState.CurrentHistoryNode.Next == null) {
            AppState.AutoAdvance = false;
            StateHasChanged();
            return;
        }

        AppState.CurrentHistoryNode = AppState.CurrentHistoryNode.Next;
        await Redraw();
    }

    private async Task ReverseHistory() {
        AppState.AutoAdvance = false;
        var canChange = await CanChangeHistory();
        if (!canChange)
            return;

        if (AppState.CurrentHistoryNode.Previous == null)
            return;

        AppState.CurrentHistoryNode = AppState.CurrentHistoryNode.Previous;
        await Redraw();
    }

    private async Task<bool> CanChangeHistory() {
        if (AppState.GraphHistory == null)
            return false;
        if (AppState.CurrentHistoryNode == null) {
            AppState.CurrentHistoryNode = AppState.GraphHistory.First;
            await Redraw();
            return false;
        }

        return true;
    }

    private async Task Redraw() {
        SyncView();

        await FillCanvases();
        await UpdateVisualsFromGraphState();
        StateHasChanged();
    }

    private async Task FillCanvases() {
        if (ShowsPreviousCanvas) {
            /* Stepping back to the first state left the "Previous" canvas showing whatever frame
             * was drawn last, because it was only ever painted when a previous state existed. */
            if (AppState.CurrentHistoryNode.Previous != null)
                await FillCanvas(PreviousCanvasId, AppState.CurrentHistoryNode.Previous.Value);
            else
                await ResetCanvasOf(PreviousCanvasId);
        }

        await FillCanvas(CurrentCanvasId, AppState.CurrentHistoryNode.Value);
    }

    private const string PreviousCanvasId = "previousCanvas";
    private const string CurrentCanvasId = "currentCanvas";

    /* The whole frame is described in .NET (CanvasRenderer fills a CanvasScene) and painted by
     * canvas.js in one interop call. It went through Excubo's Batch2D before, which serialised
     * every canvas call one by one: about 25 ms per canvas and step for twelve nodes. The length
     * labels are measured by the page as it draws them, so that round trip is gone as well. */
    private async Task FillCanvas(string canvasId, GraphState state) {
        var settings = AppState.CanvasSettings;
        var scene = NewScene(settings);

        if (settings.ShowGrid)
            CanvasRenderer.DrawGrid(scene, settings);
        CanvasRenderer.DrawEdges(scene, state, AppState.CurrentHistoryNode, settings);
        CanvasRenderer.DrawNodes(scene, state, AppState.CurrentHistoryNode, settings);

        await JS.InvokeVoidAsync("tspCanvas.draw", canvasId, scene.ToJson());
    }

    private async Task ResetCanvases() {
        /* The "Previous" canvas is only in the markup for SA, HC and the manual mode; canvas.js
         * skips a canvas that is not in the document. */
        if (ShowsPreviousCanvas)
            await ResetCanvasOf(PreviousCanvasId);

        await ResetCanvasOf(CurrentCanvasId);
    }

    /* The canvas cleared to the background, with the grid if it is on. */
    private async Task ResetCanvasOf(string canvasId) {
        var settings = AppState.CanvasSettings;
        var scene = NewScene(settings);
        if (settings.ShowGrid)
            CanvasRenderer.DrawGrid(scene, settings);

        await JS.InvokeVoidAsync("tspCanvas.draw", canvasId, scene.ToJson());
    }

    /* Everything is drawn in CSS pixels; the page's transform maps them onto the buffer, which is
     * PixelRatio times larger, and the whole canvas - not only the graph's extent - is cleared. */
    private static CanvasScene NewScene(CanvasSettings settings) => new() {
        Width = settings.Width,
        Height = settings.Height,
        Ratio = settings.PixelRatio,
        Background = settings.Theme.Background
    };

    /* The "Previous" canvas shows the state a step is taken from. Simulated Annealing and Hill
     * Climbing use it for the iteration boundary, the manual mode for the tour before and after
     * the move that was just applied - which is the whole point of playing one by hand. */
    /* Only the manual mode has a second table, and AppState.DistanceTable keeps whatever @ref last
     * put there - so after switching away it still points at a component that is no longer in the
     * document. Same trap as the charts: the reference has to be checked together with the mode. */
    private bool ShowsDistanceTable => AppState.AlgorithmEnum == AlgorithmEnum.Manual;

    /* Annealing records a state per draw, so its canvases are the tour before and after one draw
     * (a rejected draw leaves it as it was, with the neighbour it turned down drawn dashed). */
    private string PreviousCaption => AppState.AlgorithmEnum switch {
        AlgorithmEnum.Manual => "Previous (Before the Move)",
        AlgorithmEnum.SA => "Previous (Before the Draw)",
        _ => "Previous (Iteration Start)"
    };

    private string CurrentCaption => AppState.AlgorithmEnum switch {
        AlgorithmEnum.Manual => "Current (After the Move)",
        AlgorithmEnum.SA => "Current (After the Draw)",
        _ => "Current (Iteration End)"
    };

    private bool ShowsPreviousCanvas =>
        AppState.AlgorithmEnum is AlgorithmEnum.SA or AlgorithmEnum.HC or AlgorithmEnum.Manual;

    /* The tour the move panel builds on: the one currently displayed, so that stepping back and
     * applying something else works on what is on screen rather than on the last state. */
    /* The heuristic that produced the history on screen. The manual panel used to act on any
     * history: run Simulated Annealing, switch to Manual Search without executing, and Apply,
     * Undo and Back to start rewrote and then deleted the annealing run. The panel now only works
     * on a run that Manual Search started; otherwise it asks for Execute. */
    private AlgorithmEnum? runAlgorithm;

    private bool HasManualRun =>
        runAlgorithm == AlgorithmEnum.Manual && AppState.GraphHistory != null && AppState.CurrentHistoryNode != null;

    private bool CanUndoManualMove => HasManualRun && AppState.CurrentHistoryNode.Previous != null;

    private GraphProblem CurrentTour() =>
        HasManualRun ? ManualSearch.TourOf(AppState.CurrentHistoryNode.Value) : null;

    private async Task ApplyManualMove(ITourMove move) {
        if (!HasManualRun || move == null)
            return;

        AppState.AutoAdvance = false;
        AppState.CurrentHistoryNode =
            AppState.ManualSearch.Apply(AppState.GraphHistory, AppState.CurrentHistoryNode, move);

        await Redraw();
    }

    private async Task UndoManualMove() {
        if (!HasManualRun)
            return;

        AppState.AutoAdvance = false;
        AppState.CurrentHistoryNode = ManualSearch.Undo(AppState.GraphHistory, AppState.CurrentHistoryNode);
        await Redraw();
    }

    private async Task ResetManualMoves() {
        if (!HasManualRun)
            return;

        AppState.AutoAdvance = false;
        AppState.CurrentHistoryNode = ManualSearch.Reset(AppState.GraphHistory);
        await Redraw();
    }

    private async Task UpdateEnumerator() {
        runAlgorithm = AppState.AlgorithmEnum;
        AppState.Instance.Reset();
        AppState.TableGenerator.Reset();
        if (ShowsDistanceTable)
            AppState.DistanceTable?.Reset();
        await ResetCanvases();

        AppState.Stopwatch.Restart();

        switch (AppState.AlgorithmEnum) {
            case AlgorithmEnum.NN:
                AppState.NearestNeighbor.Start = AppState.Instance.Nodes[AppState.StartNode];
                AppState.GraphHistory = AppState.MultiStart ?
                    AppState.NearestNeighbor.MultiStart(AppState.Instance) :
                    AppState.NearestNeighbor.FindPath(AppState.Instance);
                break;
            case AlgorithmEnum.SA:
                AppState.SimulatedAnnealing.Alpha = AppState.AlphaSA;
                AppState.SimulatedAnnealing.PhaseLength = AppState.PhaseLength;
                AppState.SimulatedAnnealing.StartTemp = AppState.StartTemp;
                AppState.SimulatedAnnealing.MinTemp = AppState.MinTemp;
                AppState.SimulatedAnnealing.NeighbourEnum = AppState.NeighbourEnum;
                AppState.SimulatedAnnealing.CalculateTemperature = AppState.CalculateTemperature;
                AppState.GraphHistory = AppState.SimulatedAnnealing.FindPath(AppState.Instance);
                break;
            case AlgorithmEnum.AS:
                AppState.AntSystem.Iterations = AppState.Iterations;
                AppState.AntSystem.AntCount = AppState.AntCount;
                AppState.AntSystem.Alpha = AppState.AlphaACS;
                AppState.AntSystem.Beta = AppState.Beta;
                AppState.AntSystem.BreakWhenPathsAreEqual = AppState.BreakWhenPathsAreEqual;
                AppState.AntSystem.GlobalUpdatingRule = AppState.GlobalUpdatingRule;
                AppState.AntSystem.SelectionRule = AppState.SelectionRule;
                AppState.GraphHistory = AppState.AntSystem.FindPath(AppState.Instance);
                break;
            case AlgorithmEnum.HC:
                AppState.HillClimbing.NeighbourEnum = AppState.NeighbourEnum;
                AppState.HillClimbing.DescentType = AppState.DescentType;
                AppState.GraphHistory = AppState.MultiStart ?
                    AppState.HillClimbing.MultiStart(AppState.Instance) :
                    AppState.HillClimbing.FindPath(AppState.Instance);
                break;
            case AlgorithmEnum.Manual:
                /* Nothing is searched here. The history starts with the given tour and grows one
                 * entry per move the user applies. */
                AppState.GraphHistory = AppState.ManualSearch.FindPath(AppState.Instance);
                break;
        }

        AppState.SourceText = GraphProblem.SerializeGraph(AppState.Instance);
        AppState.Stopwatch.Stop();
        AppState.TimeSpan = AppState.Stopwatch.Elapsed;

        AppState.CurrentHistoryNode = AppState.GraphHistory.First;
        await Redraw();
    }

    private async Task UpdateVisualsFromGraphState() {
        AppState.TableGenerator.UpdateFromGraphState(AppState.CurrentHistoryNode, AppState.AlgorithmEnum, AppState.NeighbourEnum);
        if (ShowsDistanceTable) {
            AppState.DistanceTable?.UpdateFromGraphState(
                AppState.CurrentHistoryNode, AppState.AlgorithmEnum, AppState.NeighbourEnum);
        }

        /* AppState.ChartJS keeps whatever @ref last put there, so after a run that rendered charts
         * the entries survive a switch to an algorithm that renders none - and updating one of
         * those calls into a canvas that is no longer in the document. Only the charts the current
         * markup actually shows are refreshed, which mirrors the @if blocks above. */
        for (int i = 0; i < ChartCount(); i++) {
            var chart = AppState.ChartJS[i];
            if (chart != null)
                await chart.UpdateFromGraphState(AppState.CurrentHistoryNode.Value.ChartInfo[i],
                    AppState.CurrentHistoryNode.Value.ChartCursor);
        }
    }

    private int ChartCount() {
        var available = AppState.CurrentHistoryNode?.Value.ChartInfo?.Count ?? 0;

        return AppState.AlgorithmEnum switch {
            AlgorithmEnum.SA => Math.Min(2, available),
            AlgorithmEnum.HC or AlgorithmEnum.Manual => Math.Min(1, available),
            _ => 0
        };
    }
}