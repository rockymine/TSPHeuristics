@using TravellingSalesmanProblem.Algorithms

@* In the order the lecture introduces the schedule: T₀ (or its estimate), the cooling factor α,
   the phase length it, the stopping temperature, and the move. Each label is plain words first with
   the lecture's symbol as a chip; the input ids are kept for the tests. *@
<div class="form-group">
    <label for="temp1">Initial temperature <span class="sym">T<sub>0</sub></span></label>
    <input type="number" id="temp1" class="form-control" disabled="@CalculateTemperature"
           @bind:get="StartTemp" @bind:set="v => StartTempChanged.InvokeAsync(v)">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="calculateTemperature" @bind:get="CalculateTemperature" @bind:set="v => CalculateTemperatureChanged.InvokeAsync(v)">
        <label class="form-check-label" for="calculateTemperature">Estimate from the graph</label>
    </div>
    <small class="form-text">@(CalculateTemperature
        ? "T₀ = shortest farthest-neighbor tour minus shortest nearest-neighbor tour, over all start nodes."
        : "Higher accepts longer tours more often at the start.")</small>
</div>
<div class="form-group">
    <label for="alphaSA">Cooling factor <span class="sym">&alpha;</span></label>
    <input type="number" step="0.01" id="alphaSA" class="form-control" @bind:get="AlphaSA" @bind:set="v => AlphaSAChanged.InvokeAsync(v)">
    <small class="form-text">After each phase T ← &alpha; &middot; T. Closer to 1 cools more slowly.</small>
</div>
<div class="form-group">
    <label for="iter1">Phase length <span class="sym">it</span></label>
    <input type="number" id="iter1" class="form-control" @bind:get="PhaseLength" @bind:set="v => PhaseLengthChanged.InvokeAsync(v)">
    <small class="form-text">Draws at each temperature.</small>
</div>
<div class="form-group">
    <label for="temp2">Minimum temperature <span class="sym">T<sub>min</sub></span></label>
    @* Written out as a decimal: the bound double rendered as "1E-08", which reads as a code. *@
    <input type="number" step="any" id="temp2" class="form-control"
           value="@MinTemp.ToString("0.##########", System.Globalization.CultureInfo.InvariantCulture)"
           @onchange="SetMinTemp">
    <small class="form-text">The run stops once T falls below it.</small>
</div>
<NeighborFunctionSettings NeighbourEnum="@NeighbourEnum" NeighbourEnumChanged="@NeighbourEnumChanged"></NeighborFunctionSettings>

@code {
    private Task SetMinTemp(ChangeEventArgs e) =>
        double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                        System.Globalization.CultureInfo.InvariantCulture, out var value)
            ? MinTempChanged.InvokeAsync(value)
            : Task.CompletedTask;

    [Parameter]
    public NeighbourType NeighbourEnum { get; set; }
    [Parameter]
    public EventCallback<NeighbourType> NeighbourEnumChanged { get; set; }

    [Parameter]
    public int PhaseLength { get; set; }
    [Parameter]
    public EventCallback<int> PhaseLengthChanged { get; set; }

    [Parameter]
    public double StartTemp { get; set; }
    [Parameter]
    public EventCallback<double> StartTempChanged { get; set; }

    [Parameter]
    public double MinTemp { get; set; }
    [Parameter]
    public EventCallback<double> MinTempChanged { get; set; }

    [Parameter]
    public double AlphaSA { get; set; }
    [Parameter]
    public EventCallback<double> AlphaSAChanged { get; set; }

    [Parameter]
    public bool CalculateTemperature { get; set; }
    [Parameter]
    public EventCallback<bool> CalculateTemperatureChanged { get; set; }
}