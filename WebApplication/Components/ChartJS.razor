@inject IJSRuntime JSRuntime
@using ChartData
@using TravellingSalesmanProblem.Graph
<h5>@Chart.Title</h5>
<div class="chart-box"><canvas id="@ChartID"></canvas></div>

@code {
	[Parameter]
	public ChartInfo Chart { get; set; }
	[Parameter]
	public string ChartID { get; set; }
	/* The point to highlight (GraphState.ChartCursor), or -1. */
	[Parameter]
	public int Cursor { get; set; } = -1;

	/* The data last sent. A chart shared by all states of a run only needs its cursor moved. */
	private ChartInfo sent;

	private Task<IJSObjectReference> _module;
    private Task<IJSObjectReference> Module => _module
		??= JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/ChartJSInterop.js").AsTask();

	protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
			var module = await Module;
			await module.InvokeVoidAsync("LineChart", ChartID, Chart, Cursor);
			sent = Chart;
        }

        await base.OnAfterRenderAsync(firstRender);
    }

	/* Takes the state's chart data from the caller. It used to send its Chart parameter, which
	 * is only refreshed when the page renders - and the playback loop updates the charts before
	 * that render, so during playback the chart showed the previous state. */
	public async Task UpdateFromGraphState(ChartInfo chart, int cursor = -1) {
		var module = await Module;
		chart ??= Chart;

		if (ReferenceEquals(chart, sent) && cursor >= 0 &&
			await module.InvokeAsync<bool>("SetCursor", ChartID, cursor))
			return;

		await module.InvokeVoidAsync("LineChart", ChartID, chart, cursor);
		sent = chart;
		StateHasChanged();
	}
}