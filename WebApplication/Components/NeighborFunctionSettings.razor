@using TravellingSalesmanProblem.Algorithms
<div class="form-group">
    <label for="selectNeighbourType">Neighbour Function</label>
    <select class="form-control" name="neighbourType" id="selectNeighbourType" @bind:get="NeighbourEnum" @bind:set="v => NeighbourEnumChanged.InvokeAsync(v)">
        <option value="TwoOpt">2-Opt</option>
        @*<option value="ThreeOpt">3-Opt</option>
        <option value="FourOpt">Double-bridge 4-Opt</option>*@
        <option value="Swap">Swap</option>
    </select>
</div>

@code {
    [Parameter]
    public NeighbourType NeighbourEnum { get; set; }
    [Parameter]
    public EventCallback<NeighbourType> NeighbourEnumChanged { get; set; }
}