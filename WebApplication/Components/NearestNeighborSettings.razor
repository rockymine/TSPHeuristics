<div class="form-group">
    <label for="startnodeselect">Start Node</label>
    <div id="startnodeselect" class="input-group">
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom"
            title="Increase start node position" @onclick="() => StartNodeChanged.InvokeAsync(StartNode + 1)"><i class="bi bi-plus-lg"></i></button>
        <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="tooltip" data-bs-placement="bottom"
            title="Decrease start node position" @onclick="() => StartNodeChanged.InvokeAsync(StartNode - 1)"><i class="bi bi-dash-lg"></i></button>
        <div class="input-group-text">@StartNode</div>
    </div>
</div>

@code {
    [Parameter]
    public int StartNode { get; set; }
    [Parameter]
    public EventCallback<int> StartNodeChanged { get; set; }
}