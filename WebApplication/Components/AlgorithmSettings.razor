@using TravellingSalesmanProblem.Algorithms
<div class="form-group">
    <label for="selectHeuristics">Heuristic</label>
    <select class="form-control" name="heuristics" id="selectHeuristics" @bind:get="AlgorithmEnum" @bind:set="v => AlgorithmEnumChanged.InvokeAsync(v)">
        <option value="NN">Nearest Neighbor</option>
        <option value="SA">Simulated Annealing</option>
        <option value="AS">Ant System</option>
        <option value="HC">Hill Climbing</option>
        <option value="Manual">Manual Search</option>
    </select>
</div>
@if (AlgorithmEnum is AlgorithmEnum.NN or AlgorithmEnum.HC) {
    <div class="form-check">
        <input type="checkbox" class="form-check-input" id="multi" @bind:get="MultiStart" @bind:set="v => MultiStartChanged.InvokeAsync(v)">
        <label class="form-check-label" for="multi">Multi Start</label>
    </div>
}

@code {
    [Parameter]
    public AlgorithmEnum AlgorithmEnum { get; set; }
    [Parameter]
    public EventCallback<AlgorithmEnum> AlgorithmEnumChanged { get; set; }

    [Parameter]
    public bool MultiStart { get; set; }
    [Parameter]
    public EventCallback<bool> MultiStartChanged { get; set; }
}