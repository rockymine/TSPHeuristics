@using TravellingSalesmanProblem.Algorithms
@* ACS notation as in the thesis: α is the global pheromone decay, β the weight of the distance. *@
<div class="form-group">
    <label for="iterations">Iterations <span class="sym">t<sub>max</sub></span></label>
    <input type="number" id="iterations" class="form-control" @bind:get="Iterations" @bind:set="v => IterationsChanged.InvokeAsync(v)">
</div>
<div class="form-group">
    <label for="ants">Ants <span class="sym">m</span></label>
    <input type="number" id="ants" class="form-control" @bind:get="AntCount" @bind:set="v => AntCountChanged.InvokeAsync(v)">
</div>
<div class="form-group">
    <label for="alphaACS">Pheromone decay <span class="sym">&alpha;</span></label>
    <input type="number" step="0.05" id="alphaACS" class="form-control" @bind:get="AlphaACS" @bind:set="v => AlphaACSChanged.InvokeAsync(v)">
    <small class="form-text">Share of the pheromone that evaporates after each iteration.</small>
</div>
<div class="form-group">
    <label for="beta">Distance weight <span class="sym">&beta;</span></label>
    <input type="number" step="0.5" id="beta" class="form-control" @bind:get="Beta" @bind:set="v => BetaChanged.InvokeAsync(v)">
    <small class="form-text">Higher prefers short edges more strongly.</small>
</div>
<div class="form-group">
    <label for="selectSelectionRule">Next-node rule</label>
    <select class="form-control" name="selectionRule" id="selectSelectionRule" @bind:get="SelectionRule" @bind:set="v => SelectionRuleChanged.InvokeAsync(v)">
        <option value="Proportional">Random proportional</option>
        <option value="Greedy">Greedy (always the strongest edge)</option>
    </select>
</div>
<div class="form-group">
    <label for="selectUpdatingRule">Pheromone deposit</label>
    <select class="form-control" name="updatingRule" id="selectUpdatingRule" @bind:get="GlobalUpdatingRule" @bind:set="v => GlobalUpdatingRuleChanged.InvokeAsync(v)">
        <option value="ACS">Best tour only (ACS)</option>
        <option disabled value="AS">Every ant (Ant System)</option>
    </select>
</div>
<div class="form-group form-check">
    <input class="form-check-input" type="checkbox" id="breakWhenEqual" @bind:get="BreakWhenPathsAreEqual" @bind:set="v => BreakWhenPathsAreEqualChanged.InvokeAsync(v)">
    <label class="form-check-label" for="breakWhenEqual">Stop early when all ants find the same tour</label>
</div>

@code {
    [Parameter]
    public int Iterations { get; set; }
    [Parameter]
    public EventCallback<int> IterationsChanged { get; set; }

    [Parameter]
    public int AntCount { get; set; }
    [Parameter]
    public EventCallback<int> AntCountChanged { get; set; }

    [Parameter]
    public double AlphaACS { get; set; }
    [Parameter]
    public EventCallback<double> AlphaACSChanged { get; set; }

    [Parameter]
    public double Beta { get; set; }
    [Parameter]
    public EventCallback<double> BetaChanged { get; set; }

    [Parameter]
    public bool BreakWhenPathsAreEqual { get; set; }
    [Parameter]
    public EventCallback<bool> BreakWhenPathsAreEqualChanged { get; set; }

    [Parameter]
    public SelectionRule SelectionRule { get; set; }
    [Parameter]
    public EventCallback<SelectionRule> SelectionRuleChanged { get; set; }

    [Parameter]
    public GlobalUpdatingRule GlobalUpdatingRule { get; set; }
    [Parameter]
    public EventCallback<GlobalUpdatingRule> GlobalUpdatingRuleChanged { get; set; }
}