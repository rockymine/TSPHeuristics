@inject IJSRuntime JSRuntime

<button class="btn btn-outline-secondary btn-sm" type="button" title="Download the graph as text, in the format the Text source reads"
        disabled="@string.IsNullOrEmpty(Content)" @onclick="DownloadFileFromStream">
    <i class="bi bi-download"></i> Download graph
</button>

@code {
    [Parameter]
    public string Content { get; set; }

    private async Task DownloadFileFromStream() {
        if (string.IsNullOrEmpty(Content))
            return;

        byte[] file = System.Text.Encoding.UTF8.GetBytes(Content);
        await JSRuntime.InvokeVoidAsync("BlazorDownloadFile", Guid.NewGuid().ToString() + ".txt", "text/plain", file);
    }
}
