@* How the graph is drawn - not what is solved or how. These sit in the view bar under the canvases
   they change, and take effect at once (GraphView.ApplyView). *@
<div class="toolbar-group" role="group" aria-label="View">
    <button type="button" class="btn btn-sm btn-toggle" aria-pressed="@Pressed(ShowGrid)" id="showGrid"
            title="Grid lines behind the graph" @onclick="() => ShowGridChanged.InvokeAsync(!ShowGrid)">
        <Icon Name="grid-3x3" /><span>Grid</span>
    </button>
    <button type="button" class="btn btn-sm btn-toggle" aria-pressed="@Pressed(ColorizeChanges)" id="switchColor"
            title="Color the edges a step adds (green) and removes (red, dashed), and the nodes it moves"
            @onclick="() => ColorizeChangesChanged.InvokeAsync(!ColorizeChanges)">
        <Icon Name="palette" /><span>Highlight changes</span>
    </button>
    <button type="button" class="btn btn-sm btn-toggle" aria-pressed="@Pressed(AnnotateEdges)" id="switchAnnotate"
            title="Write each edge's length on it" @onclick="() => AnnotateEdgesChanged.InvokeAsync(!AnnotateEdges)">
        <Icon Name="ruler" /><span>Edge lengths</span>
    </button>
</div>

@code {
    [Parameter] public bool ShowGrid { get; set; }
    [Parameter] public EventCallback<bool> ShowGridChanged { get; set; }

    [Parameter] public bool AnnotateEdges { get; set; }
    [Parameter] public EventCallback<bool> AnnotateEdgesChanged { get; set; }

    [Parameter] public bool ColorizeChanges { get; set; }
    [Parameter] public EventCallback<bool> ColorizeChangesChanged { get; set; }

    private static string Pressed(bool on) => on ? "true" : "false";
}
