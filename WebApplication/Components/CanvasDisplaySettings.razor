@* How the graph is drawn - not what is solved or how. These sit in the stage toolbar next to the
   canvases they change, and take effect on the canvas at once (GraphView.ApplyView); in the sidebar
   they were mixed in with the instance's limits and only applied on the next Execute. *@
<div class="toolbar-group" role="group" aria-label="View">
    <button type="button" class="btn btn-sm btn-toggle" aria-pressed="@Pressed(ShowGrid)" id="showGrid"
            title="Grid lines at every whole coordinate" @onclick="() => ShowGridChanged.InvokeAsync(!ShowGrid)">
        <i class="bi bi-grid-3x3"></i><span>Grid</span>
    </button>
    <button type="button" class="btn btn-sm btn-toggle" aria-pressed="@Pressed(ColorizeChanges)" id="switchColor"
            title="Colour the edges a step adds and removes, and the nodes it moves"
            @onclick="() => ColorizeChangesChanged.InvokeAsync(!ColorizeChanges)">
        <i class="bi bi-palette"></i><span>Changes</span>
    </button>
    <button type="button" class="btn btn-sm btn-toggle" aria-pressed="@Pressed(AnnotateEdges)" id="switchAnnotate"
            title="Write each edge's length on it" @onclick="() => AnnotateEdgesChanged.InvokeAsync(!AnnotateEdges)">
        <i class="bi bi-rulers"></i><span>Lengths</span>
    </button>
    <label class="toolbar-field" for="nodeSize" title="Node radius in pixels">
        <span>Node</span>
        <input type="number" id="nodeSize" class="form-control form-control-sm" min="1" max="30"
               value="@NodeRadius" @onchange="SetNodeRadius">
    </label>
</div>

@code {
    [Parameter] public float NodeRadius { get; set; }
    [Parameter] public EventCallback<float> NodeRadiusChanged { get; set; }

    [Parameter] public bool ShowGrid { get; set; }
    [Parameter] public EventCallback<bool> ShowGridChanged { get; set; }

    [Parameter] public bool AnnotateEdges { get; set; }
    [Parameter] public EventCallback<bool> AnnotateEdgesChanged { get; set; }

    [Parameter] public bool ColorizeChanges { get; set; }
    [Parameter] public EventCallback<bool> ColorizeChangesChanged { get; set; }

    private static string Pressed(bool on) => on ? "true" : "false";

    private Task SetNodeRadius(ChangeEventArgs e) =>
        float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
                       System.Globalization.CultureInfo.InvariantCulture, out var radius)
            ? NodeRadiusChanged.InvokeAsync(radius)
            : Task.CompletedTask;
}
