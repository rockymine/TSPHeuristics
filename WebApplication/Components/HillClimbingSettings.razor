@using TravellingSalesmanProblem.Algorithms
<div>
    <div class="form-group">
        <label for="selectDescentType">Descent Type</label>
        <select class="form-control" name="descentType" id="selectDescentType" @bind:get="DescentType" @bind:set="v => DescentTypeChanged.InvokeAsync(v)">
            <option value="Random">Random Descent</option>
            <option value="Next">Next Descent</option>
            <option value="Steepest">Steepest Descent</option>
        </select>
    </div>
    <NeighborFunctionSettings NeighbourEnum="@NeighbourEnum" NeighbourEnumChanged="@NeighbourEnumChanged"></NeighborFunctionSettings>
</div>

@code {
    [Parameter]
    public DescentType DescentType { get; set; }
    [Parameter]
    public EventCallback<DescentType> DescentTypeChanged { get; set; }

    [Parameter]
    public NeighbourType NeighbourEnum { get; set; }
    [Parameter]
    public EventCallback<NeighbourType> NeighbourEnumChanged { get; set; }
}