@using TravellingSalesmanProblem.Algorithms
<div>
    <div class="form-group">
        <label for="selectDescentType">Move selection</label>
        <select class="form-control" name="descentType" id="selectDescentType" @bind:get="DescentType" @bind:set="v => DescentTypeChanged.InvokeAsync(v)">
            <option value="Random">Random improving move</option>
            <option value="Next">First improvement (next descent)</option>
            <option value="Steepest">Best improvement (steepest descent)</option>
        </select>
        <small class="form-text">@(DescentType switch {
            DescentType.Random => "Draws neighbors at random and takes the first shorter one.",
            DescentType.Next => "Scans the neighborhood in order and takes the first shorter tour.",
            _ => "Checks the whole neighborhood and takes the shortest tour."
        })</small>
    </div>
    <NeighborFunctionSettings NeighbourEnum="@NeighbourEnum" NeighbourEnumChanged="@NeighbourEnumChanged"></NeighborFunctionSettings>
</div>

@code {
    [Parameter]
    public DescentType DescentType { get; set; }
    [Parameter]
    public EventCallback<DescentType> DescentTypeChanged { get; set; }

    [Parameter]
    public NeighbourType NeighbourEnum { get; set; }
    [Parameter]
    public EventCallback<NeighbourType> NeighbourEnumChanged { get; set; }
}