@using TravellingSalesmanProblem.Algorithms
@using TravellingSalesmanProblem.Graph
@using WebApplication.Utils
@using StardustDL.RazorComponents.Markdown

@if (tableInfo.HasData) {
	var cols = Math.Min(tableInfo.Header.Count, MaxCols + 1);
	var rows = Math.Min(tableInfo.Cells.GetLength(0), MaxRows);

	<h5>@title</h5>
	<div class="table-responsive">
		<table class="table" style="text-align: center">
			<thead>
				<tr>
					@for (int i = 0; i < cols; i++) {
						<th>@Render(tableInfo.Header[i])</th>
					}

					@if (cols < tableInfo.Cells.GetLength(1)) {
						<th>
							<p><i class="bi bi-three-dots"></i></p>
						</th>
					}
				</tr>
				
			</thead>
			<tbody>
				@for (int i = 0; i < rows; i++) {
					<tr>
						@for (int j = 0; j < cols; j++) {
							<td class="@tableInfo.Cells[i,j].Class">@Render(tableInfo.Cells[i,j].Value)</td>
						}

						@if (cols < tableInfo.Cells.GetLength(1)) {
							<td>
								<i class="bi bi-three-dots"></i>
							</td>
						}
					</tr>
				}

				@if (rows < tableInfo.Cells.GetLength(0)) {
					<tr>
						@for (int j = 0; j < cols; j++) {
							<td><i class="bi bi-three-dots-vertical"></i></td>
						}

						@if (cols < tableInfo.Cells.GetLength(1)) {
							<td>
								<div style="transform: rotate(45deg);">
									<i class="bi bi-three-dots"></i>
								</div>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	</div>

	<!-- Table expansion through modal -->
	@if (CanShowModal) {
		@if (rows < tableInfo.Cells.GetLength(0) || cols < tableInfo.Cells.GetLength(1)) {
			<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal"
					@onclick="OpenModal">
				Show Full Table
			</button>
		}

		<!-- Modal -->
		<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-full-width">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
								@onclick="CloseModal"></button>
					</div>
					<div class="modal-body">
						@if (modalOpen) {
							<TableGenerator @ref=modalTable CanShowModal="false"
											MaxCols="ModalMaxCols" MaxRows="ModalMaxRows" Kind="Kind" />
						}
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"
								@onclick="CloseModal">Close</button>
					</div>
				</div>
			</div>
		</div>
	}
}

@code {
	[Parameter]
	public bool CanShowModal { get; set; } = true;
	[Parameter]
	public int MaxCols { get; set; } = int.MaxValue - 1;
	[Parameter]
	public int MaxRows { get; set; } = int.MaxValue;
	/* Which table to build. Auto follows the algorithm, which is what a single table per run needs;
	 * the manual mode shows two at once and has to be able to ask for the distance matrix
	 * regardless of what the algorithm would pick. */
	[Parameter]
	public TableKind Kind { get; set; } = TableKind.Auto;

	/* The full table used to be part of every render, hidden behind the modal's CSS but present in
	 * the DOM all the same - and the distance matrix has n*(n+1) cells, 40382 of them at n=200.
	 * Building it cost the browser five minutes of blocked UI thread for a run whose FindPath took
	 * 56 ms. It is now built when the modal is opened and dropped when it is closed. The cap keeps
	 * even that bounded; the rows and columns beyond it are marked with the same ellipsis cells the
	 * inline table already uses. */
	private const int ModalMaxCols = 200;
	private const int ModalMaxRows = 200;

	private TableInfo tableInfo = new();
	private string title;
	private TableGenerator modalTable;
	private bool modalOpen;
	private LinkedListNode<GraphState> lastNode;
	private AlgorithmEnum lastAlgorithm;
	private NeighbourType lastNeighbour;

	public bool HasData => tableInfo.HasData;

	public void Reset() {
		tableInfo = new TableInfo();
		modalOpen = false;
		modalTable?.Reset();
		modalTable = null;
	}

	private void OpenModal() => modalOpen = true;

	private void CloseModal() {
		modalOpen = false;
		modalTable = null;
	}

	/* @ref is assigned after the render that creates the child, so the freshly opened modal has to
	 * be filled on the following render pass. */
	protected override void OnAfterRender(bool firstRender) {
		if (modalOpen && modalTable != null && !modalTable.HasData && lastNode != null) {
			modalTable.UpdateFromGraphState(lastNode, lastAlgorithm, lastNeighbour);
		}
	}

	/* MarkdownRenderer parses and typesets every value it is given. Most cells - the distances, the
	 * node indices, the tours - contain no math and no markup, and routing those through the parser
	 * was the single largest cost of a redraw. They are emitted directly; only values carrying
	 * LaTeX still go through the renderer. All content here is generated from node indices and
	 * distances, so there is nothing user supplied to escape. */
	private RenderFragment Render(string value) => builder => {
		if (string.IsNullOrEmpty(value))
			return;

		if (value.Contains('$')) {
			builder.OpenComponent<MarkdownRenderer>(0);
			builder.AddAttribute(1, nameof(MarkdownRenderer.Value), value);
			builder.CloseComponent();
			return;
		}

		builder.AddContent(2, (MarkupString)value);
	};

	public void UpdateFromGraphState(LinkedListNode<GraphState> node, AlgorithmEnum algorithmEnum, NeighbourType neighbourType) {
		lastNode = node;
		lastAlgorithm = algorithmEnum;
		lastNeighbour = neighbourType;
		tableInfo.Header.Clear();

		if (Kind == TableKind.DistanceMatrix || (Kind == TableKind.Auto && algorithmEnum == AlgorithmEnum.NN)) {
			title = "Distance Matrix";
			CreateDistanceMatrix(node);
		} else if (algorithmEnum == AlgorithmEnum.Manual) {
			title = "Move History";
			CreateMoveHistory(node);
		} else if (algorithmEnum is AlgorithmEnum.SA or AlgorithmEnum.HC &&
			neighbourType is NeighbourType.Swap or NeighbourType.TwoOpt) {
			title = "Neighbor Function History";
			CreateSwapSummary(node, neighbourType);
		} else {
			title = "Tour History";
			CreateIterationTable(node);
		}

		StateHasChanged();
		modalTable?.UpdateFromGraphState(node, algorithmEnum, neighbourType);
	}

	private void CreateDistanceMatrix(LinkedListNode<GraphState> node) {
		var state = node.Value;

		tableInfo.Header.Add("");
		var size = state.Nodes.Count + 1;
		tableInfo.Cells = new TableCellInfo[size - 1, size];

		/* InPath scanned the whole tour for every cell, so the matrix cost O(n^3) to build and it
		 * was rebuilt on every animation frame - roughly 700k comparisons per frame at the 90 node
		 * maximum. The tour's adjacent pairs are collected once instead. */
		var adjacent = PathPairs(state.Path);

		for (int i = 0; i < size - 1; i++) {
			for (int j = 0; j < size; j++) {
				var node1 = state.Nodes[i];

				if (j == 0) {
					tableInfo.Cells[i, j] = new TableCellInfo(node1.Index.ToString(), "font-weight-bold");
					continue;
				}

				var node2 = state.Nodes[j - 1];

				if (i == 0)
					tableInfo.Header.Add(node2.Index.ToString());
				if (j - i - 1 < 0) {
					tableInfo.Cells[i, j] = new TableCellInfo("<i class=\"bi bi-dash-lg\"></i>", null);
					continue;
				}

				var distance = Math.Round(Edge.GetDistanceRounded(node1, node2), 1);

				tableInfo.Cells[i, j] = new TableCellInfo(distance.ToString(),
					adjacent.Contains(Pair(node1, node2)) ? "table-light" : null);
			}
		}
	}

	private static HashSet<(int, int)> PathPairs(List<Node> path) {
		var pairs = new HashSet<(int, int)>();
		for (int i = 0; i < path.Count - 1; i++)
			pairs.Add(Pair(path[i], path[i + 1]));

		return pairs;
	}

	private static (int, int) Pair(Node a, Node b) =>
		a.Index < b.Index ? (a.Index, b.Index) : (b.Index, a.Index);

	/* Both history tables used to append one row per call, and this component is updated on every
	 * redraw. Stepping backwards - or replaying - therefore appended rows that were already there,
	 * so the table filled up with duplicates and disagreed with the visualization. Each table is
	 * now derived from the history up to the selected state, which makes it idempotent.
	 * TableInfo.AddRow also reallocated and copied the whole array per row, making the build
	 * quadratic in the number of iterations; rows are collected in a list and converted once. */
	private void CreateIterationTable(LinkedListNode<GraphState> node) {
		tableInfo.Header = new List<string> { "Iteration", "Tour", "Distance" };

		var rows = new List<TableCellInfo[]>();
		foreach (var state in HistoryUpTo(node)) {
			if (state.Path.Count == 0)
				continue;

			rows.Add(new[] {
				new TableCellInfo(state.Iteration.ToString(), null),
				new TableCellInfo("(" + string.Join('-', state.Path.Select(n => n.Index)) + ")", null),
				new TableCellInfo(state.Distance.ToString(), null)
			});
		}

		tableInfo.Cells = ToGrid(rows, tableInfo.Header.Count);
	}

	private static IEnumerable<GraphState> HistoryUpTo(LinkedListNode<GraphState> node) {
		var states = new List<GraphState>();
		for (var current = node.List?.First; current != null; current = current.Next) {
			states.Add(current.Value);
			if (current == node)
				break;
		}

		return states;
	}

	private static TableCellInfo[,] ToGrid(List<TableCellInfo[]> rows, int columns) {
		var grid = new TableCellInfo[rows.Count, columns];
		for (int i = 0; i < rows.Count; i++) {
			for (int j = 0; j < columns && j < rows[i].Length; j++)
				grid[i, j] = rows[i][j];
		}

		return grid;
	}

	/* A hand played search mixes move types, so the rule cannot come from a run level setting the
	 * way it does for Hill Climbing and Simulated Annealing - each row states its own, and the
	 * calculation column holds the numbers that move actually used. That is the column a student
	 * checks their own arithmetic against. */
	private void CreateMoveHistory(LinkedListNode<GraphState> node) {
		tableInfo.Header = new List<string> { "#", "Move", "Nodes", "Tour", "$\\triangle$", "f(x)" };

		var rows = new List<TableCellInfo[]>();
		foreach (var state in HistoryUpTo(node)) {
			var info = state.MoveInfo;

			rows.Add(new[] {
				new TableCellInfo(state.Iteration.ToString(), null),
				new TableCellInfo(info == null ? "start" : ManualSearch.Label(info.Type), null),
				new TableCellInfo(info == null ? "" : string.Join(", ", info.Nodes.Select(n => n.Index)), null),
				new TableCellInfo("(" + string.Join("-", state.Path.Select(n => n.Index)) + ")", null),
				new TableCellInfo(info?.Calculation ?? "", null),
				new TableCellInfo(Math.Round(state.Distance, 3).ToString(),
					info != null && info.Delta < 0 ? "table-light" : null)
			});
		}

		tableInfo.Cells = ToGrid(rows, tableInfo.Header.Count);
	}

	private void CreateSwapSummary(LinkedListNode<GraphState> node, NeighbourType neighbourType) {
		var formula = "$\\triangle=d_{i,j}+d_{i+1,j+1}-d_{i,i+1}-d_{j,j+1}$";

		if (neighbourType == NeighbourType.Swap)
			formula = "$\\triangle_{i,j}=\\begin{cases}d_{i,j-1}+d_{i,j+1}-d_{i,i-1}-d_{j,j+1},&i=j-1\\parallel j-1=i+1\\\\d_{j-1,i}+d_{j,i+1}-d_{j-1,j}-d_{i,i+1},&i=j+1 \\parallel j+1=i-1\\\\d_{i-1,j}+d_{j,i+1}+d_{j-1,i}+d_{i,j+1}-d_{i-1,i}-d_{i,i+1}-d_{j-1,j}-d_{j,j+1},&else\\end{cases}$";

		tableInfo.Header = new List<string> { "It.", "$i$", "$j$", "x", formula, "y" , "f(y)"};

		var rows = new List<TableCellInfo[]>();
		GraphState previous = null;

		foreach (var state in HistoryUpTo(node)) {
			if (state.MoveInfo == null || state.MoveInfo.Nodes.Count < 2) {
				previous = state;
				continue;
			}

			var i = state.MoveInfo.Nodes[0];
			var j = state.MoveInfo.Nodes[1];

			rows.Add(new[] {
				new TableCellInfo($"${state.Iteration}$", null),
				new TableCellInfo($"${i.Index}$", null),
				new TableCellInfo($"${j.Index}$", null),
				IndexedTourSummary(previous, i, j),
				new TableCellInfo(state.MoveInfo.Calculation, null),
				IndexedTourSummary(state, i, j),
				new TableCellInfo(Math.Round(state.Distance, 1).ToString(), null)
			});

			previous = state;
		}

		tableInfo.Cells = ToGrid(rows, tableInfo.Header.Count);
	}

	/* Took the "before" state as an argument that could be null (node.Previous?.Value on the very
	 * first entry) and dereferenced it unguarded. */
	private TableCellInfo IndexedTourSummary(GraphState state, Node i, Node j) {
		if (state == null)
			return new TableCellInfo("", null);

		var content = string.Join(',', state.Path.Select(n =>
				n == i ? "\\underset{i}{\\text{" + n.Index + "}}" :
				n == j ? "\\underset{j}{\\text{" + n.Index + "}}" :
				n.Index.ToString()));

		return new TableCellInfo("$("+ $"{content}" + ")$", null);
	}

}